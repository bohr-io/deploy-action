{
  "name": "@bohr/deploy-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "GitHub Action that deploys a bohr.io Cloud managed project: a wrapper that runs the latest bohr CLI (packages/cli).",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --legal-comments=none --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
